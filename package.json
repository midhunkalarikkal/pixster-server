        "16.-chat-app": "file:..",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.20.3",
        "cookie-parser": "^1.4.7",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
